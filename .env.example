# Baza (PostgreSQL — domyślny schemat w projekcie)
DATABASE_URL="postgresql://user:haslo@localhost:5432/zabiegi"

# NextAuth
NEXTAUTH_SECRET="wygeneruj-openssl-rand-base64-32"
NEXTAUTH_URL="https://twoja-domena.pl"
# Google OAuth (logowanie/rejestracja klienta)
# 1) Utwórz OAuth Client ID w Google Cloud (Authorized redirect URI: https://twoja-domena.pl/api/auth/callback/google)
# 2) Włącz przycisk w UI ustawiając NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=1
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="0"

# Aplikacja
NEXT_PUBLIC_BASE_PATH=""
# Opcjonalnie: zdjęcie hero na /portal (ścieżka z /public lub pełny URL). Bez tego używany jest domyślny obraz z Unsplash.
# NEXT_PUBLIC_PORTAL_HERO_IMAGE="/zabiegihero.jpg"

# Slideshow z muzyką na /rafal-kowalkowski/galeria — pełny URL pliku MP3 (bez tego: ambient2.mp3 jak na fotoferia.pl/zdjecia dnia).
# NEXT_PUBLIC_RAFAL_GALLERY_AUDIO_URL="https://odart.pl/wp-content/uploads/2026/01/twoj-utwor.mp3"

# Admin (min. 10 znaków hasła) — seed utworzy konto do panelu /portal/admin
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""

# Opcjonalnie: CSV emaili kont gabinetów z rolą admin (np. "a@x.pl,b@y.pl")
# ADMIN_EMAILS="a@x.pl,b@y.pl"

# Opcjonalnie: hasło konta demo (min. 10 znaków) — seed utworzy demo@skinmatch.pl dla gabinetu odkryj-blask
# DEMO_CLINIC_PASSWORD=""

# Cosmo Scheduler (WordPress) — kalendarz i rezerwacje w panelu gabinetu
# 1) W WordPress: Kosmetyczka → Ustawienia SMS — ustaw Klucz API (public)
# 2) Wklej ten sam klucz poniżej (BOOKING_WP_API_KEY) i ustaw URLe
BOOKING_WP_AVAILABILITY_URL="https://salon.odart.pl/wp-json/cosmo/v1/public/available-times"
BOOKING_WP_BOOKING_URL="https://salon.odart.pl/wp-json/cosmo/v1/public/appointments"
BOOKING_WP_API_KEY=""

# VetHarmonogram (weterynaria.odart.pl) — rejestracja przychodni
# false = mail z linkiem przed logowaniem (produkcja); true = od razu aktywne (tylko dev)
# VET_AUTO_VERIFY="false"

# E-mail (potwierdzenie rejestracji klienta) — bez SMTP link jest tylko w logach (dev)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="noreply@example.com"

# VetHarmonogram — SMS (SMSAPI.pl), opcjonalnie
# VET_SMSAPI_TOKEN=""
# VET_SMS_FROM="VetHarmonogram"
# CRON_SECRET=""  # GET /api/cron/vet-reminders?secret=...
# GET /api/cron/gab-reminders?secret=...
# GET /api/cron/gab-client-messages?secret=...
# GET /api/cron/randki-vibe-catalog?secret=...  # codziennie: cache Spotify/YouTube moodów

# Randka Odart — katalog moodów (opcjonalnie; bez tego działa kuratorski seed)
# SPOTIFY_CLIENT_ID=""
# SPOTIFY_CLIENT_SECRET=""
# YOUTUBE_API_KEY=""
# TMDB_API_KEY=""  # filmy w katalogu moodów (themoviedb.org)
# TMDB_READ_ACCESS_TOKEN=""  # preferowany Bearer token z panelu TMDB

# Randka Odart — true = rejestracja bez maila weryfikacyjnego (tylko dev/staging)
# RANDKI_AUTO_VERIFY="false"
# Podgląd wieczornych pokoi na panelu (10 fikcyjnych profili)
# RANDKI_DEMO_ROOMS=1 — demo pokoi + przełącznik faz dnia (?phase=morning|day|sunset|evening|night)
# GAB_AUTO_VERIFY="true"  # auto-aktywacja konta gabinetu (jak VET_AUTO_VERIFY)
# GAB_SMSAPI_TOKEN=""  # opcjonalnie, fallback: SMSAPI_TOKEN

# reCAPTCHA v2 (rejestracja klienta) — bez kluczy CAPTCHA jest pomijana
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""

# --- DPD (SOAP) — wyłącznie server-side; nie używaj NEXT_PUBLIC_ ---
# Model zamów „Zamów”: kurier odbiera i dowozi pod adres (świeży towar) — wystarczą poniższe
# dane SOAP (etykiety, zlecenia, śledzenie). MyPudo = opcjonalnie tylko gdy kiedyś dodasz odbiór w punkcie.
# Login/hasło z panelu integracji DPD; FID-y z umowy / zgłoszenia API.
# DPD_SERVICES_LOGIN=""
# DPD_SERVICES_PASSWORD=""
# DPD_MASTER_FID=""
# DPD_SERVICES_FID=""
# DPD_APP_SERVICES_FID=""
# DPD_INFO_SERVICES_CHANNELS=""
# DPD_SERVICES_DUTY_MODULE_FID=""
# Opcjonalnie: MyPudo (punkty PUDO) — przy samym dowozie do klienta zwykle zbędne
# DPD_MYPUDO_API_LOGIN=""
# DPD_MYPUDO_API_PASSWORD=""
# DPD_MYPUDO_API_KEY=""
# DPD_MYPUDO_API_URL="https://mypudo.dpd.com.pl/api/pudo/"
# Tryb testowy SOAP (host demo): "1" / produkcja: "0" lub puste
# DPD_SANDBOX="0"
# Opcjonalnie własny host SOAP (nadpisuje sandbox)
# DPD_SERVICES_HOST=""
# Opcjonalnie pełne URLe WSDL, jeśli DPD poda inne ścieżki
# DPD_WSDL_PACKAGE_OBJ=""
# DPD_WSDL_APP_SERVICE_OBJ=""
# DPD_WSDL_INFO_SERVICES_EVENTS=""
# DPD_SERVICES_DUTY_MODULE_WSDL_URL=""
